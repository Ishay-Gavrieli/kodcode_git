def revers(lst:list):
    result = []
    for i in range(1 , len(lst) + 1):
        result.append(lst[-i])
    return result


# question 20

def without_duplicates(lst:list):
    result = []
    for i in lst:
        if i not in result:
            result.append(i)
    return result
