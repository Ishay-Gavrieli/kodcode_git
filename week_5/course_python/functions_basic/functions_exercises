def is_anagrams(s1:str,s2:str) -> bool:
    new_str1 = sorted(s1)
    new_str2 = sorted(s2)
    if len(new_str2) != len(new_str1):
        return False
    for i in range(len(new_str2)):
        if new_str1[i] != new_str2[i]:
            return False
        
    return True


